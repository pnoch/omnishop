{
  "name": "omnishop",
  "version": "5.32.53",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:metro\"",
    "dev:server": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "dev:metro": "cross-env EXPO_USE_METRO_WORKSPACE_ROOT=1 npx expo start --web --port ${EXPO_PORT:-8081}",
    "build": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && pnpm build:web",
    "build:web": "expo export -p web --output-dir dist-web",
    "build:apk": "cd android && ./gradlew assembleRelease",
    "build:android-js": "expo export -p android --output-dir .expo-android-export",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "expo lint app components lib hooks server shared scripts desktop/src desktop/tests tests -- --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "node scripts/test-db.mjs",
    "test:rust": "cargo test --manifest-path desktop/src-tauri/Cargo.toml",
    "check:rust": "cargo fmt --manifest-path desktop/src-tauri/Cargo.toml --check && cargo clippy --manifest-path desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "verify": "pnpm check && pnpm lint && pnpm test:coverage && pnpm check:desktop && pnpm --dir desktop test && pnpm check:rust && pnpm test:rust && pnpm build:android-js && pnpm build:desktop",
    "smoke:web": "tsx scripts/smoke-web.ts",
    "smoke:a11y": "tsx scripts/smoke-a11y.ts",
    "audit:layout": "tsx scripts/audit-layout.ts",
    "audit:contrast": "tsx scripts/audit-contrast.ts",
    "audit:desktop": "node scripts/audit-desktop.mjs",
    "budget:web": "node scripts/check-bundle-budget.mjs",
    "e2e:smoke": "tsx scripts/e2e-smoke.ts",
    "e2e:shared": "tsx scripts/e2e-shared-watchlist.ts",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:migrate": "drizzle-kit migrate",
    "db:check-migrations": "node scripts/check-migration-drift.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "qr": "node scripts/generate_qr.mjs",
    "generate-fixtures": "tsx scripts/generate-fixtures.ts",
    "dev:desktop": "pnpm --filter desktop dev",
    "build:desktop": "pnpm --filter desktop build",
    "check:desktop": "pnpm --filter desktop check"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/datetimepicker": "9.3.0",
    "@react-native-cookies/cookies": "6.2.1",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/elements": "^2.9.46",
    "@react-navigation/native": "^7.5.2",
    "@tanstack/react-query": "^5.108.4",
    "@trpc/client": "11.31.2",
    "@trpc/react-query": "11.28.5",
    "@trpc/server": "11.31.2",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "compression": "1.8.2",
    "cookie": "^2.0.2",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.26",
    "expo-background-task": "~58.0.13",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-server-sdk": "^8.0.0",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-task-manager": "~58.0.14",
    "expo-web-browser": "~58.1.0",
    "express": "^5.3.0",
    "fuse.js": "^7.5.0",
    "impit": "0.14.9",
    "jose": "6.2.18",
    "mysql2": "^3.24.6",
    "nativewind": "^4.2.7",
    "patchright": "1.64.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-reanimated": "4.8.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-view-shot": "6.2.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.14.0",
    "sharp": "^0.35.5",
    "superjson": "^2.2.7",
    "tailwind-merge": "^3.7.1",
    "undici": "8.13.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.1.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie": "^1.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/node-forge": "1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "5.1.1",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-expo": "~58.0.4",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  },
